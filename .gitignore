# =============================================
# Ignore EVERYTHING by default
# =============================================
*

# Allow folders to be traversed
!*/

# =============================================
# Allow .gitignore itself
# =============================================
!.gitignore

# =============================================
# B0__ageing - Allow ONLY CNN_Crossformer files
# =============================================
!B0__ageing/CNN_Crossformer.py
!B0__ageing/CNN_Crossformer_LossCurve.png
!B0__ageing/CNN_Crossformer_SoH_Prediction.png
!B0__ageing/CNN_Crossformer_LossCurve.mat
!B0__ageing/CNN_Crossformer_SoH_Prediction.mat

# =============================================
# Fast_charging - Allow ONLY CNN_Crossformer files
# =============================================
!Fast_charging/CNN_Crossformer.py
!Fast_charging/CNN_Crossformer_LossCurve.png
!Fast_charging/CNN_Crossformer_SoH_Prediction.png
!Fast_charging/CNN_Crossformer_LossCurve.mat
!Fast_charging/CNN_Crossformer_SoH_Prediction.mat

# =============================================
# Nasa_Datasets - Allow ONLY CNN_Crossformer files
# =============================================
!Nasa_Datasets/CNN_Crossformer.py
!Nasa_Datasets/CNN_Crossformer_SOH_prediction.png
!Nasa_Datasets/CNN_Crossformer_training_loss.png
!Nasa_Datasets/CNN_Crossformer_SOH_prediction.mat
!Nasa_Datasets/CNN_Crossformer_training_loss.mat

# =============================================
# OS Files
# =============================================
.DS_Store
Thumbs.db
desktop.ini

# =============================================
# Logs & temp files
# =============================================
*.log
*.tmp
*.temp